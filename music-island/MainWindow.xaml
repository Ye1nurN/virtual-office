<Window x:Class="Ostrov.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Остров" Width="440" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#F0F0F2"
 UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_KeyDown"
 Deactivated="Window_Deactivated" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Icons.xaml" /></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="Accent" Color="#BABAC4" />
   <Style TargetType="Button">
    <Setter Property="Foreground" Value="#F0F0F2" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
     </Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#29292E" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BABAC4" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="7" />
   </Style>
   <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="PlayCircle" Background="{TemplateBinding Background}" CornerRadius="24" Padding="13"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlayCircle" Property="Background" Value="#393940" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PlayCircle" Property="BorderBrush" Value="#BABAC4" /><Setter TargetName="PlayCircle" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Icon" TargetType="Path"><Setter Property="Fill" Value="#F0F0F2" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
   <Style TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True" /><Setter Property="Height" Value="24" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
     <Grid Margin="3,0"><Border Height="4" Background="#38383F" CornerRadius="2" VerticalAlignment="Center" />
      <Track x:Name="PART_Track">
       <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#BABAC4" CornerRadius="2" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
       <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
       <Track.Thumb><Thumb Width="10" Height="10"><Thumb.Template><ControlTemplate><Ellipse Fill="#BABAC4" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      </Track>
     </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F0F0F2" /><Setter Property="Background" Value="#1B1B1F" /><Setter Property="BorderBrush" Value="#404047" /><Setter Property="Padding" Value="10,7" /><Setter Property="FontSize" Value="13" /></Style>
   <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#F0F0F2" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
   <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Selection" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Stretch" /></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#232328" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#BABAC4" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border x:Name="Surface" Margin="10,4,10,10" CornerRadius="24" Background="#0D0D10" BorderBrush="#303036" BorderThickness="1" Padding="18,16,18,10">
  <Border.RenderTransform><TranslateTransform x:Name="Slide" /></Border.RenderTransform>
  <StackPanel>
   <DockPanel Margin="0,0,0,10">
    <Button DockPanel.Dock="Right" Click="Dismiss_Click" Width="28" Height="28" Padding="6" ToolTip="Скрыть" AutomationProperties.Name="Скрыть"><Path Style="{StaticResource Icon}" Data="{StaticResource IconX}" Width="14" Height="14" Fill="#ABABB4" /></Button>
    <Button x:Name="SourceButton" Content="Сейчас играет ▾" Click="Source_Click" HorizontalAlignment="Left" FontSize="11" Foreground="#BABAC4" Padding="7,4" AutomationProperties.Name="Источник музыки" />
   </DockPanel>
   <StackPanel x:Name="ExternalEmptyPane" Visibility="Collapsed" Margin="4,4,4,12">
    <TextBlock x:Name="ExternalEmptyTitle" Text="Включи музыку" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="ExternalEmptyHint" Text="Запусти трек в Telegram Desktop или другом плеере. Он появится здесь автоматически." TextWrapping="Wrap" Foreground="#B3B3BC" FontSize="13" LineHeight="21" Margin="0,10,0,16" />
    <Button Content="Моя локальная музыка" Click="Local_Click" HorizontalAlignment="Left" Background="#29292F" />
    <TextBlock x:Name="ExternalShortcutHint" Foreground="#A3A3AD" FontSize="11" Margin="0,16,0,0" />
   </StackPanel>
   <Grid x:Name="EmptyPane">
    <StackPanel Margin="4,5,4,10">
     <Path Style="{StaticResource Icon}" Data="{StaticResource IconMusicNotes}" Width="34" Height="34" Fill="#BABAC4" HorizontalAlignment="Left" Margin="0,0,0,14" />
     <TextBlock Text="Твоя музыка под рукой" FontSize="20" FontWeight="SemiBold" />
     <TextBlock Text="Добавь файлы или папку с музыкой.&#x0a;Плеер скроется, а музыка продолжит играть." Foreground="#B3B3BC" FontSize="13" LineHeight="21" Margin="0,9,0,15" />
     <UniformGrid Columns="2"><Button Content="Добавить файлы" Click="AddFiles_Click" Background="#29292F" Margin="0,0,5,0" /><Button Content="Добавить папку" Click="AddFolder_Click" Background="#222227" Margin="5,0,0,0" /></UniformGrid>
     <TextBlock x:Name="ShortcutHint" Text="Alt+M — открыть · Esc — скрыть" Foreground="#A3A3AD" FontSize="11" Margin="0,16,0,0" />
    </StackPanel>
   </Grid>
   <StackPanel x:Name="PlayerPane" Visibility="Collapsed">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
     <Border Width="74" Height="74" CornerRadius="5" Background="#202025" ClipToBounds="True">
      <Grid><Path x:Name="CoverFallback" Style="{StaticResource Icon}" Data="{StaticResource IconMusicNotes}" Width="32" Height="32" Fill="#BABAC4" /><Image x:Name="Cover" Stretch="UniformToFill" /></Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,6,0">
      <TextBlock x:Name="TrackTitle" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="TrackArtist" FontSize="13" Foreground="#ABABB4" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="2"><Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Click="Favorite_Click" ToolTip="В избранное" AutomationProperties.Name="В избранное"><Path x:Name="FavoriteIcon" Style="{StaticResource Icon}" Data="{StaticResource IconHeart}" /></Button>
      <Button Style="{StaticResource IconButton}" Click="Menu_Click" ToolTip="Библиотека и настройки" AutomationProperties.Name="Библиотека и настройки"><Path Style="{StaticResource Icon}" Data="{StaticResource IconGearSix}" Width="18" Height="18" Fill="#ABABB4" /></Button>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="ProgressPanel">
    <Slider x:Name="PositionSlider" Margin="0,8,0,0" Minimum="0" Maximum="1" SmallChange="5" LargeChange="10" ValueChanged="Position_Changed" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" LostMouseCapture="Seek_End" AutomationProperties.Name="Позиция трека" />
    <DockPanel Margin="2,-2,2,0"><TextBlock x:Name="DurationText" DockPanel.Dock="Right" Text="0:00" Foreground="#CCCCD3" FontSize="11" /><TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#CCCCD3" FontSize="11" /></DockPanel>
    </StackPanel>
    <TextBlock x:Name="TimelineUnavailable" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#A3A3AD" FontSize="11" Margin="0,12,0,0" />
    <Grid Margin="0,10,0,14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
     <UniformGrid Columns="3" Margin="0,0,14,0">
      <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Click="Previous_Click" ToolTip="Предыдущий" AutomationProperties.Name="Предыдущий"><Path Style="{StaticResource Icon}" Data="{StaticResource IconSkipBack}" /></Button>
      <Button x:Name="PlayButton" Style="{StaticResource PlayButtonStyle}" Width="48" Height="48" Background="#29292F" Padding="13" Click="Play_Click" ToolTip="Воспроизвести / пауза" AutomationProperties.Name="Воспроизвести / пауза"><Path x:Name="PlayIcon" Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Fill="#F0F0F2" /></Button>
      <Button x:Name="NextButton" Style="{StaticResource IconButton}" Click="Next_Click" ToolTip="Следующий" AutomationProperties.Name="Следующий"><Path Style="{StaticResource Icon}" Data="{StaticResource IconSkipForward}" /></Button>
     </UniformGrid>
     <Border x:Name="LocalVolume" Grid.Column="1" BorderBrush="#303036" BorderThickness="1,0,0,0" Padding="8,0,0,0" VerticalAlignment="Center"><DockPanel>
      <Button Style="{StaticResource IconButton}" Width="30" DockPanel.Dock="Left" Click="Mute_Click" AutomationProperties.Name="Включить или выключить звук"><Path x:Name="VolumeIcon" Style="{StaticResource Icon}" Data="{StaticResource IconSpeakerHigh}" Width="20" Height="20" /></Button>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="Volume_Changed" VerticalAlignment="Center" AutomationProperties.Name="Громкость" />
     </DockPanel></Border>
     <TextBlock x:Name="ExternalStatus" Grid.Column="1" Text="Telegram" TextWrapping="Wrap" Foreground="#BABAC4" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
    </Grid>
    <Border x:Name="LocalActions" BorderBrush="#303036" BorderThickness="0,1,0,0" Padding="0,9,0,0"><UniformGrid Columns="2">
     <Button Click="Queue_Click" AutomationProperties.Name="Очередь"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconPlaylist}" Margin="0,0,9,0" /><TextBlock Text="Очередь" VerticalAlignment="Center" /></StackPanel></Button>
     <Button Click="Similar_Click" AutomationProperties.Name="Похожее"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource IconSparkle}" Fill="#BABAC4" Margin="0,0,9,0" /><TextBlock Text="Похожее" Foreground="#BABAC4" VerticalAlignment="Center" /></StackPanel></Button>
    </UniformGrid></Border>
    <TextBlock x:Name="ExternalFooter" Text="Громкость и очередь — в приложении" Foreground="#A3A3AD" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed" />
   </StackPanel>
   <StackPanel x:Name="LibraryPane" Visibility="Collapsed">
    <DockPanel Margin="0,0,0,12"><Button Style="{StaticResource IconButton}" DockPanel.Dock="Left" Click="Back_Click" AutomationProperties.Name="Назад"><Path Style="{StaticResource Icon}" Data="{StaticResource IconArrowLeft}" /></Button>
     <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Click="AddFiles_Click" ToolTip="Добавить музыку" AutomationProperties.Name="Добавить музыку"><Path Style="{StaticResource Icon}" Data="{StaticResource IconFolderPlus}" /></Button>
     <StackPanel VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="ListTitle" Text="Библиотека" FontWeight="SemiBold" FontSize="17" /><TextBlock x:Name="ListSubtitle" Foreground="#ABABB4" FontSize="11" Margin="0,3,0,0" /></StackPanel>
    </DockPanel>
    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Поиск по названию или исполнителю" AutomationProperties.Name="Поиск музыки" Margin="0,0,0,8" />
    <ListBox x:Name="TrackList" Height="260" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
     <ListBox.ItemTemplate><DataTemplate><Button Click="PlayItem_Click" HorizontalContentAlignment="Stretch" Padding="8,9" ToolTip="{Binding Path}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" /><TextBlock Text="{Binding Subtitle}" Foreground="#ABABB4" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
      <Path Grid.Column="1" Style="{StaticResource Icon}" Data="{StaticResource IconPlay}" Width="15" Height="15" Fill="#BABAC4" />
     </Grid></Button></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
   <Border x:Name="NoticeBox" Visibility="Collapsed" Background="#222227" CornerRadius="6" Margin="0,10,0,0" Padding="9,7"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="11" Foreground="#D6D6DC" /></Border>
  </StackPanel>
 </Border>
</Window>
